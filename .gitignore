# build / runtime
bin/
obj/
build/
dist/
out/
*.user
*.suo
.vs/
.idea/
*.swp

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# node (if a web client appears later)
node_modules/
.pnpm-store/

# os
.DS_Store
Thumbs.db
desktop.ini

# local game data
saves/
*.log
*.tmp

# tooling artifacts
.dsh-vision-router/
.vscode/

# local env / secrets — never commit API keys
.env
.env.*
!.env.example

# scratch
.tmp/

# build output
web/

# 调研与拆解资料（本地参考，不发布）
对接池/

# artdrop：外部绘图 AI 的交接目录（只保留骨架与示例）
artdrop/inbox/*
!artdrop/inbox/README.md
!artdrop/inbox/_example/
!artdrop/inbox/_example/**
artdrop/processed/*
!artdrop/processed/.gitkeep
artdrop/rejected/*
!artdrop/rejected/.gitkeep
artdrop/refs/*
!artdrop/refs/README.md

# artdrop 备份（编码器会写）
artdrop/backups/*
!artdrop/backups/.gitkeep
