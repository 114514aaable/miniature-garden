{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://newworld.dev/spec/0.1/entity.schema.json",
  "title": "Entities File",
  "description": "实体文件：地点、势力、NPC、物品、生物。实体是运行时唯一的对象来源。",
  "type": "object",
  "required": ["entities"],
  "additionalProperties": false,
  "properties": {
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entity" }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["id", "kind", "name"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{2,47}$" },
        "kind": {
          "enum": ["location", "faction", "npc", "item", "creature", "event"]
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 60 },
        "summary": { "type": "string", "maxLength": 400 },
        "region": {
          "type": ["string", "null"],
          "description": "所属区域 id；势力、物品可为 null。"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 24 }
        },
        "props": {
          "type": "object",
          "description": "引擎与模组可读的自由属性，值必须是标量或标量数组。",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "array", "items": { "oneOf": [{ "type": "string" }, { "type": "number" }] } }
            ]
          }
        },
        "location": { "$ref": "#/$defs/location" },
        "faction": { "$ref": "#/$defs/faction" },
        "npc": { "$ref": "#/$defs/npc" },
        "item": { "$ref": "#/$defs/item" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "location" } }, "required": ["kind"] },
          "then": { "required": ["location"] }
        },
        {
          "if": { "properties": { "kind": { "const": "faction" } }, "required": ["kind"] },
          "then": { "required": ["faction"] }
        },
        {
          "if": { "properties": { "kind": { "const": "npc" } }, "required": ["kind"] },
          "then": { "required": ["npc", "region"] }
        }
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "services": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["rest", "trade", "heal", "train", "rumor", "quest"] }
        },
        "exits": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "相邻地点实体 id。双向性由校验器检查。"
        }
      }
    },
    "faction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creed": { "type": "string", "maxLength": 200 },
        "wants": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "maxLength": 120 }
        },
        "seats": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "势力据点所在区域 id。"
        }
      }
    },
    "npc": {
      "type": "object",
      "required": ["persona"],
      "additionalProperties": false,
      "properties": {
        "persona": {
          "type": "object",
          "required": ["role", "voice"],
          "additionalProperties": false,
          "properties": {
            "role": { "type": "string", "maxLength": 60 },
            "voice": {
              "type": "string",
              "maxLength": 300,
              "description": "说话方式的一句话描述，供无 LLM 时选台词、有 LLM 时约束文风。"
            },
            "traits": {
              "type": "array",
              "maxItems": 6,
              "items": { "type": "string", "maxLength": 24 }
            },
            "wants": {
              "type": "array",
              "maxItems": 4,
              "items": { "type": "string", "maxLength": 120 }
            },
            "fears": {
              "type": "array",
              "maxItems": 4,
              "items": { "type": "string", "maxLength": 120 }
            }
          }
        },
        "faction": { "type": ["string", "null"] },
        "tier": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2,
          "default": 0,
          "description": "AI 分级：0 脚本、1 本地小模型、2 云端关键 NPC。"
        },
        "knowledge": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" },
          "description": "此人明确知晓的知识条目 id；未列出的由知识解析器按区域/势力/事件推导。"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "price": { "type": "integer", "minimum": 0 },
        "effects": {
          "type": "array",
          "maxItems": 6,
          "items": { "type": "string", "maxLength": 120 }
        }
      }
    }
  }
}
